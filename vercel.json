{
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/penalty.js": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/JeetOS.html"
    },
    {
      "source": "/api/schedule.ics",
      "destination": "/api/schedule-ics"
    }
  ],
  "crons": [
    {
      "path": "/api/telegram-checkin?type=morning",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/telegram-checkin?type=night",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/telegram-weekly-report",
      "schedule": "30 15 * * 0"
    },
    {
      "path": "/api/coach-nudge?slot=morning",
      "schedule": "45 2 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=afternoon",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=evening",
      "schedule": "45 11 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=night",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=review",
      "schedule": "15 6 * * 0"
    },
    {
      "path": "/api/coach-nudge?slot=streak",
      "schedule": "45 15 * * *"
    },
    {
      "path": "/api/penalty?slot=night",
      "schedule": "45 19 * * *"
    },
    {
      "path": "/api/penalty?slot=afternoon",
      "schedule": "45 8 * * *"
    },
    {
      "path": "/api/penalty?slot=evening",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=anchor&anchor=wake",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=anchor&anchor=gym",
      "schedule": "10 4 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=anchor&anchor=breakfast",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=anchor&anchor=work",
      "schedule": "10 7 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=anchor&anchor=lunch",
      "schedule": "40 9 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=anchor&anchor=snack",
      "schedule": "10 12 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=anchor&anchor=leave",
      "schedule": "40 16 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=anchor&anchor=dinner",
      "schedule": "40 17 * * *"
    },
    {
      "path": "/api/coach-nudge?slot=anchor&anchor=sleep",
      "schedule": "10 19 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
